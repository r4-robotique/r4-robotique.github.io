{% extends 'base.html.twig' %}

{% block body %}
    <h2 class="d-flex flex-wrap justify-content-between align-items-center">
    Working group archive videos
    <a class="btn btn-primary" href="{{ path('/speakers') }}">Speakers</a>
    </h2>

    <div class="videos-search my-3">
        <input type="search" id="videos-search" class="form-control form-control-lg"
            placeholder="Search videos (title, speaker, abstract, transcript...)" aria-label="Search videos"
            autocomplete="off" data-index="{{ path('/videos-index') }}" />
        <div id="videos-categories" class="mt-2">
            {% for category in categories %}
            <button type="button" class="btn btn-sm btn-outline-secondary videos-category"
                data-category="{{ category.id }}" title="{{ category.description }}" aria-pressed="false">{{ category.label }}</button>
            {% endfor %}
        </div>
        <div id="videos-search-status" class="text-muted mt-2" aria-live="polite"></div>
    </div>

    <div id="videos-search-results" class="row" hidden></div>

    <div id="videos-listing">
    {% include '_navigation.html.twig' %}

    <div class="row">
        {% for event in events %}
        <div class="col-sm-6 p-2">
        <div class="card h-100">
            <div class="card-header">
            <div class="card-title">
            <h4>
                {{ event.title }}
                <br/>
                <small>
                <span class="text-muted">
                    {% if event.speakers %}
                    <em>
                        {{ event.speakers }}
                    </em>
                    {% endif %}
                    <span class="badge badge-warning">{{ event.date_start|date("Y-m-d") }}</span>
                </span>
                </small>
                {% if event.categories %}
                <div class="videos-pills">
                    {% for category in event.categories %}
                    <a class="badge badge-pill badge-secondary videos-category" data-category="{{ category.id }}"
                        href="{{ path('/videos') }}?c={{ category.id }}">{{ category.label }}</a>
                    {% endfor %}
                </div>
                {% endif %}
            </h4>
            </div>
            </div>
            
            <div class="card-body">
            <div class="card-text">

            <iframe width="100%" height="315" src="https://www.youtube.com/embed/{{ event.youtube }}" 
            title="YouTube video player" 
            frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            </div>
        </div>
        </div>
        {% endfor %}
    </div>

    {% include '_navigation.html.twig' %}
    </div>

{% endblock %}

{% block javascripts %}
<script type="text/javascript" src="{{ asset('js/videos-search.js') }}"></script>
{% endblock %}
